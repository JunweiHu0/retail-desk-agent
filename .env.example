# demo: no network/model charges, deterministic demonstration through the native tool loop.
# live: real tool-calling model, all Retail tools available.
AGENT_MODE=demo
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=
# Optional OpenAI-compatible endpoint (e.g. your model gateway).
MODEL_BASE_URL=
# auto: service default; on/off require chat_template_kwargs support.
MODEL_THINKING=auto
TAU2_ROOT=../tau2-bench
RETAIL_DB_PATH=../retail-desk-data/retail.sqlite3
RETAIL_ARTIFACT_DIR=../retail-desk-data/episodes
# Independent internal evaluator credential; leave empty to disable episode creation/export.
EVAL_API_TOKEN=
HOST=127.0.0.1
PORT=8000

# Browser account API (main contract). Use the same frontend base for subpaths.
APP_BASE_PATH=
DEMO_ACCOUNTS=1
# Existing browser sessions retain their selected variant; b1 remains the default.
BROWSER_AGENT_VARIANT=b1

# Copy to deploy/tacc/env (gitignored) and edit. Sourced by every deploy/tacc/*.sh.

# --- tcloud -------------------------------------------------------------
# Path to the SDK binary if it is not on PATH.
#TCLOUD=$HOME/Code/acsing/quickstart-v0.4.1/linux-amd64-v0.4.1/tcloud

# --- SSH tunnel (browser access) ----------------------------------------
# Only the account name and the key path are personal; host/port are the
# course gateway (port 22 is closed).
SSH_USER=your_tacc_username
SSH_KEY=$HOME/.ssh/id_ed25519
SSH_HOST=gw.turing.ust.hk
SSH_PORT=30041
LOCAL_PORT=8080

# --- ports on the compute node -----------------------------------------
AGENT_PORT=8787
SERVE_PORT=8000

# --- vLLM ---------------------------------------------------------------
# The model's chat template is XML-style; qwen3_xml and qwen3_coder map to
# the same Qwen3EngineToolParser in vLLM 0.26.
TOOL_PARSER=qwen3_xml

# Comma-separated nodes to keep away from, e.g. 10-0-1-10,10-0-1-11.
# `up.sh` appends a node automatically when the serve job dies with CUDA OOM
# (someone else's resident process is eating the GPU memory).
EXCLUDE=
